# Copia este archivo a .env y completa los valores. .env está en .gitignore: nunca lo subas.

# MySQL: la contraseña de root (solo para administrar) y la del usuario "nexus" que usa el backend
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Firma los tokens de sesión: 32 caracteres aleatorios o más (por ejemplo, openssl rand -hex 32)
JWT_SECRET=

# Primer administrador, creado al arrancar. El registro público solo crea clientes.
NEXUS_ADMIN_USERNAME=admin
NEXUS_ADMIN_PASSWORD=

# Origen del frontend (nexus-frontend-web) que puede llamar a la API desde el navegador
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Puertos en tu PC, por si ya están ocupados
# BACKEND_PORT=8080
# RISK_ENGINE_PORT=8000
# DB_PORT=3307

# Carpetas de los servicios, si ya los tienes clonados fuera de esta (por ejemplo, junto a ella)
# BACKEND_DIR=../nexus-backend-core
# RISK_ENGINE_DIR=../nexus-risk-engine
